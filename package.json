{
  "name": "wordfix",
  "private": true,
  "description": "WordFix — assistant de relecture intelligent pour documents Word longs (MVP).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck lint && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:validate": "pnpm --filter @wordfix/api prisma:validate",
    "db:generate": "pnpm --filter @wordfix/api prisma:generate",
    "db:check": "pnpm --filter @wordfix/api db:check",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:migrate": "pnpm --filter @wordfix/api db:migrate",
    "db:deploy": "pnpm --filter @wordfix/api db:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
