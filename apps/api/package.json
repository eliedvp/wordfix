{
  "name": "@wordfix/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST et worker de WordFix (NestJS).",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:check": "echo \"SELECT 1;\" | prisma db execute --stdin"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@wordfix/shared": "workspace:*",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "dotenv": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "typescript": "~6.0.3"
  }
}
