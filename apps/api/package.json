{
  "name": "@wordfix/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST et worker de WordFix (NestJS).",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --config nest-cli.worker.json",
    "start": "node dist/main.js",
    "start:worker": "node --max-old-space-size=1024 dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "echo \"SELECT 1;\" | prisma db execute --stdin",
    "sample:generate": "tsx scripts/generate-sample.ts",
    "fixtures:generate": "tsx scripts/generate-corpus.ts",
    "eval:quality": "tsx scripts/eval-quality.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@wordfix/shared": "workspace:*",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dictionary-en": "4.0.0",
    "dictionary-fr": "3.0.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mammoth": "^1.13.0",
    "nestjs-pino": "^5.3.1",
    "nspell": "2.1.5",
    "openai": "^7.27.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/nspell": "2.1.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "docx": "^9.8.1",
    "dotenv": "^17.2.0",
    "jszip": "^3.10.2",
    "pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
