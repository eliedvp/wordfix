# ---------------------------------------------------------------------------
# WordFix — variables d'environnement
#
# Copiez ce fichier en `.env` à la racine du projet :  cp .env.example .env
# Le fichier .env est ignoré par Git : n'y mettez jamais de valeur dans ce
# fichier-ci. Aucune de ces variables n'est envoyée au navigateur.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Infrastructure locale (docker compose) --------------------------------
POSTGRES_USER=wordfix
POSTGRES_PASSWORD=wordfix_dev_password
POSTGRES_DB=wordfix
POSTGRES_PORT=5432
REDIS_PORT=6379

# Doivent correspondre aux valeurs ci-dessus.
DATABASE_URL=postgresql://wordfix:wordfix_dev_password@127.0.0.1:5432/wordfix?schema=public
REDIS_URL=redis://127.0.0.1:6379

# --- API NestJS -------------------------------------------------------------
# L'API n'écoute qu'en local : le navigateur passe par le site (/api/*).
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Mandataires de confiance pour l'adresse IP réelle (X-Forwarded-For).
TRUST_PROXY=loopback

# --- Limites d'usage (décision D8) --------------------------------------------
RATE_LIMIT_PER_MINUTE=120
QUOTA_ANALYSES_PER_HOUR=3
QUOTA_ANALYSES_PER_IP_PER_DAY=10
QUOTA_UPLOADS_PER_IP_PER_HOUR=20

# --- Site Next.js -----------------------------------------------------------
# Adresse interne de l'API utilisée par les réécritures /api/* (côté serveur).
# Next.js lit ses variables dans apps/web/.env.local si besoin ; la valeur par
# défaut convient au développement local.
# API_INTERNAL_URL=http://127.0.0.1:4000

# --- Stockage des fichiers (à partir de l'étape 6) --------------------------
# local : disque (développement) ; s3 : Cloudflare R2 ou compatible S3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- IA ----------------------------------------------------------------------
# Vos clés restent uniquement dans votre .env local. Ne les collez jamais
# ailleurs (code, commit, ticket, chat). Elles ne sont lues que par le worker.
#
# Fournisseur IA : none (par défaut) | openai | gemini | fake
# - none : AUCUNE IA, aucun appel payant, aucune clé nécessaire. Seul le moteur local
#   (orthographe, grammaire avec Grammalecte, règles) analyse le document, et WordFix
#   signale que les vérifications par IA n'ont pas été faites.
# - openai / gemini : appels IA PAYANTS. Refusés au démarrage sauf si
#   AI_PAID_CALLS_ENABLED=true ET AI_DAILY_TOKEN_BUDGET > 0.
#   gemini : développement et tests uniquement, REFUSÉ si NODE_ENV=production tant
#   que la politique de confidentialité ne le mentionne pas. Sur l'offre gratuite
#   de l'API Gemini, Google peut réutiliser les contenus envoyés.
# - fake : tests automatisés uniquement (refusé hors NODE_ENV=test) ; ce n'est pas
#   une vraie correction.
AI_PROVIDER=none
# Autorisation explicite des appels IA payants (false par défaut).
AI_PAID_CALLS_ENABLED=false
OPENAI_API_KEY=
# Modèles OpenAI (à ajuster après mesure sur votre corpus) : rapide pour la relecture
# phrase par phrase, plus puissant pour la cohérence des sections et du document.
AI_MODEL_FAST=gpt-5.4-mini
AI_MODEL_SMART=gpt-5.4
# Google Gemini (AI_PROVIDER=gemini) : clé et modèles, utilisés à la place de
# AI_MODEL_FAST / AI_MODEL_SMART. Laissez la clé vide si vous n'utilisez pas Gemini.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_SMART=gemini-3.8-flash
# Requêtes Gemini par minute au plus, pour tout le worker (toutes les analyses et
# tous les morceaux). 5 = offre gratuite de gemini-3.8-flash ; à relever pour une
# offre payante. Avec plusieurs workers sur la même clé, répartissez ce quota.
GEMINI_REQUESTS_PER_MINUTE=5
# none | minimal | low | medium | high (effort de raisonnement des modèles GPT-5.x ;
# pour Gemini : none, minimal et low → niveau de réflexion LOW)
AI_REASONING_EFFORT=low
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=3
# Appels IA simultanés au plus pour une même analyse.
AI_CONCURRENCY=4
# Plafond quotidien de jetons (entrée + sortie) pour tout le service.
# 0 (par défaut) = AUCUN appel IA autorisé ; jamais « sans plafond ».
AI_DAILY_TOKEN_BUDGET=0

# --- Worker d'analyse ---------------------------------------------------------
# Analyses traitées en parallèle par un worker.
WORKER_CONCURRENCY=2

# --- Vérification grammaticale (worker) ----------------------------------------
# Grammalecte, exécuté localement par Python 3 (≥ 3.9) : aucun appel réseau.
# grammalecte | off
GRAMMAR_ENGINE=grammalecte
# Interpréteur Python (python3 par défaut ; python sous Windows).
# GRAMMALECTE_PYTHON=python3
