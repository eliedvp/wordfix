# ---------------------------------------------------------------------------
# WordFix — variables d'environnement
#
# Copiez ce fichier en `.env` à la racine du projet :  cp .env.example .env
# Le fichier .env est ignoré par Git : n'y mettez jamais de valeur dans ce
# fichier-ci. Aucune de ces variables n'est envoyée au navigateur.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Infrastructure locale (docker compose) --------------------------------
POSTGRES_USER=wordfix
POSTGRES_PASSWORD=wordfix_dev_password
POSTGRES_DB=wordfix
POSTGRES_PORT=5432
REDIS_PORT=6379

# Doivent correspondre aux valeurs ci-dessus.
DATABASE_URL=postgresql://wordfix:wordfix_dev_password@127.0.0.1:5432/wordfix?schema=public
REDIS_URL=redis://127.0.0.1:6379

# --- API NestJS -------------------------------------------------------------
# L'API n'écoute qu'en local : le navigateur passe par le site (/api/*).
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Mandataires de confiance pour l'adresse IP réelle (X-Forwarded-For).
TRUST_PROXY=loopback

# --- Limites d'usage (décision D8) --------------------------------------------
RATE_LIMIT_PER_MINUTE=120
QUOTA_ANALYSES_PER_HOUR=3
QUOTA_ANALYSES_PER_IP_PER_DAY=10
QUOTA_UPLOADS_PER_IP_PER_HOUR=20

# --- Site Next.js -----------------------------------------------------------
# Adresse interne de l'API utilisée par les réécritures /api/* (côté serveur).
# Next.js lit ses variables dans apps/web/.env.local si besoin ; la valeur par
# défaut convient au développement local.
# API_INTERNAL_URL=http://127.0.0.1:4000

# --- Stockage des fichiers (à partir de l'étape 6) --------------------------
# local : disque (développement) ; s3 : Cloudflare R2 ou compatible S3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- IA ----------------------------------------------------------------------
# Votre clé reste uniquement dans votre .env local. Ne la collez jamais
# ailleurs (code, commit, ticket, chat). Elle n'est lue que par le worker.
OPENAI_API_KEY=
# Modèles (à ajuster après mesure sur votre corpus) : rapide pour la relecture
# phrase par phrase, plus puissant pour la cohérence des sections et du document.
AI_MODEL_FAST=gpt-5.4-mini
AI_MODEL_SMART=gpt-5.4
# none | minimal | low | medium | high (effort de raisonnement des modèles GPT-5.x)
AI_REASONING_EFFORT=low
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=3
# Appels IA simultanés au plus pour une même analyse.
AI_CONCURRENCY=4
# Plafond quotidien de jetons (entrée + sortie) pour tout le service ; 0 = sans plafond.
AI_DAILY_TOKEN_BUDGET=5000000

# --- Worker d'analyse ---------------------------------------------------------
# Analyses traitées en parallèle par un worker.
WORKER_CONCURRENCY=2

# --- Vérification grammaticale (worker) ----------------------------------------
# Grammalecte, exécuté localement par Python 3 (≥ 3.9) : aucun appel réseau.
# grammalecte | off
GRAMMAR_ENGINE=grammalecte
# Interpréteur Python (python3 par défaut ; python sous Windows).
# GRAMMALECTE_PYTHON=python3
